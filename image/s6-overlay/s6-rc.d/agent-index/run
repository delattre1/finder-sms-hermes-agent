#!/bin/sh
# Reporta o uso de token deste agente pro Agent Index, de hora em hora.
#
# SEM CHAVE DE LIGA/DESLIGA. O reporter esta aqui porque alguem o colocou nesta
# imagem, e essa e a decisao. Um agente cujo dono nao quer o uso no indice e um
# agente construido sem este servico.
#
# Assado na imagem em vez de bind-mount: um mount cuja origem nao existe nao
# falha -- ele cria um DIRETORIO no destino, e o reporter roda contra um
# diretorio e reporta nada. Assado, o arquivo esta na imagem ou o build falhou.

# Absoluto: um servico herda o PATH da arvore de supervisao, nao o de um shell
# de login.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

PLOW_AGENT_TOKEN=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID

# A casa do agente e onde vive o store de uso, e o client mantem o ledger dele
# ao lado desse store. Fixo, nao configuravel: uma segunda forma de dizer onde
# ele fica so cria o caso em que reporter e agente discordam sobre qual store
# e o deles.
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: sem AGENT_ID no ambiente deste container, entao nao ha" >&2
  echo "agente pra reportar -- ficando de lado. Defina onde este container e" >&2
  echo "iniciado (environment: no compose.yml)." >&2
  exec sleep 86400
fi

while :; do
  #   0  registrado     3  nao registrado     2  o estado existe e nao foi lido
  #
  # 2 nao e 3, e isto nao pode colapsar os dois: registrar por cima de um
  # estado que o client nao conseguiu ler minta uma chave contra um install id
  # novo e abandona o uso que este install ja publicou. Essa hora e pulada.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      /command/s6-setuidgid hermes \
        env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
        /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
        --register --agent "$AGENT_ID" >/dev/null || {
      echo "agent-index: sem chave do indice nesta hora, nao vou reportar" >&2
      /bin/sleep 3600
      continue
      }
      ;;
    *)
      echo "agent-index: o client nao conseguiu ler o estado deste install" >&2
      echo "(acima); ficando de lado em vez de registrar por cima dele." >&2
      /bin/sleep 3600
      continue
      ;;
  esac

  # Nunca fatal. Um longrun que crasha seria respawnado num loop apertado, o
  # que transforma uma hora ruim num loop quente contra o indice.
  # A janela de retentativa muda conforme o reporte deu certo ou nao, e isso
  # importa mais do que parece. Numa instalacao NOVA a primeira rodada sempre
  # falha: o state.db do Hermes so nasce quando o agente atende o primeiro
  # turno, e este servico sobe antes disso. Com uma espera fixa de uma hora,
  # todo install novo passa a primeira hora marcando zero no indice -- e o
  # ranking e installs x uso, medido numa janela de sete dias. Cinco minutos
  # depois de uma falha poe o install no quadro quase na hora; uma hora depois
  # de um sucesso mantem o custo baixo no estado normal.
  if /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py; then
    /bin/sleep 3600
  else
    echo "agent-index: reporter saiu diferente de zero (acima); tento em 5 min" >&2
    /bin/sleep 300
  fi
done
